<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>

  <body>
    <div class="container">
      <div class="header-row">
        <h1>Figuritas Mundial 2026</h1>
        <button class="theme-toggle" id="themeToggle">🌙</button>
      </div>

      <div class="toolbar">
        <button class="btn active" data-filter="all">Todas</button>
        <button class="btn" data-filter="missing">Faltan</button>
        <button class="btn" data-filter="have">Repetidas</button>
      </div>

      <div class="extra-actions">
        <button id="copyMissingBtn" class="copy-btn">
          Copiar faltantes
        </button>
        <button id="copyDuplicateBtn" class="copy-btn">
          Copiar repetidas
        </button>
        <button class="copy-btn" id="copyTradeBtn">
          Copiar faltantes y repetidas
        </button>
      </div>

      <div class="countries-nav">
        {{#each groupedStickers}}
          <a class="country-chip" href="#section-{{@key}}">{{@key}}</a>
        {{/each}}
      </div>

      <section class="packs-section">
        <div class="packs-card">
          <div class="packs-header" id="packsToggle">
            <span>Sobres</span>
            <span>{{totalPacks}} sobres · {{formatNumber totalStickersOpened}} figuritas · {{formatAmount totalSpent}}</span>
          </div>

          <div class="packs-body" id="packsBody">
            <div class="packs-body-inner">
              <table class="packs-table">
                <thead>
                  <tr>
                    <th>Cantidad</th>
                    <th>Tipo</th>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>$/Sobre</th>
                    <th>Acción</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each packs}}
                    <tr id="row-{{_id}}">
                      <td class="view-mode">{{quantity}}</td>
                      <td class="view-mode">{{type}}</td>
                      <td class="view-mode">{{formatDate date}}</td>
                      <td class="view-mode">{{formatAmount amount}}</td>
                      <td class="view-mode">{{pricePerPack amount quantity}}</td>
                      <td class="view-mode actions-cell">
                        <button class="pack-btn edit-btn" onclick="editRow('{{_id}}')"><i class="fa-solid fa-pencil"></i></button>
                        <form action="/packs/{{_id}}/delete" method="POST" style="display:inline">
                          <button class="pack-btn delete-btn" type="submit"><i class="fa-solid fa-trash"></i></button>
                        </form>
                      </td>

                      <td class="edit-mode" style="display:none" colspan="6">
                        <form class="packs-form inline-edit" action="/packs/{{_id}}/update" method="POST">
                          <input type="number" name="quantity" value="{{quantity}}" min="1" required />
                          <select name="type">
                            <option value="normal" {{#if (eq type "normal")}}selected{{/if}}>Normal</option>
                            <option value="MC" {{#if (eq type "MC")}}selected{{/if}}>McDonald's</option>
                          </select>
                          <input type="date" name="date" value="{{isoDate date}}" required />
                          <input type="number" name="amount" value="{{amount}}" placeholder="Monto" min="0" step="0.01" />
                          <button type="submit">✓</button>
                          <button type="button" onclick="cancelEdit('{{_id}}')">✕</button>
                        </form>
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>

              <form class="packs-form" action="/packs" method="POST">
                <input type="number" name="quantity" placeholder="Cantidad" min="1" required />
                <select name="type">
                  <option value="normal">Normal</option>
                  <option value="MC">McDonald's</option>
                </select>
                <input type="date" name="date" required />
                <input type="number" name="amount" placeholder="Monto" min="0" step="0.01" />
                <button type="submit">Agregar</button>
              </form>
            </div>
          </div>
        </div>
      </section>

      <div class="summary">
        <h2>Resumen</h2>
        <div class="summary-grid">
          <div class="summary-card">
            <span class="label">Completado</span>
            <span class="value" data-field="completion">{{completion}}%</span>
          </div>
          <div class="summary-card">
            <span class="label">Total</span>
            <span class="value" data-field="total">{{totalCount}}</span>
          </div>
          <div class="summary-card">
            <span class="label">Me faltan</span>
            <span class="value" data-field="missing">{{missingCount}}</span>
          </div>
          <div class="summary-card">
            <span class="label">Tengo</span>
            <span class="value" data-field="owned">{{ownedCount}}</span>
          </div>
          <div class="summary-card">
            <span class="label">Repetidas</span>
            <span class="value" data-field="duplicate">{{dupCount}}</span>
          </div>
        </div>
      </div>

      {{#each groupedStickers}}
        <section
          class="album-section"
          id="section-{{@key}}"
          data-name="{{code}} {{#if flag}}{{flag}}{{else}}📜{{/if}}"
        >
          <h2 class="section-title">{{code}} - {{name}} {{#if flag}}{{flag}} {{/if}}</h2>
          <div class="stickers-grid">
            {{#each stickers}}
              <div
                class="sticker {{status}} {{#if (isSpecial code)}}special{{/if}} {{#if (isFirst code)}}captain{{/if}}"
                data-id="{{_id}}"
                data-status="{{status}}"
              >
                {{code}}
              </div>
            {{/each}}
          </div>
        </section>
      {{/each}}
    </div>

    <button class="scroll-top" id="scrollTop" aria-label="Volver arriba">↑</button>

    <script src="https://twemoji.maxcdn.com/v/latest/twemoji.min.js"></script>
    <script src="/js/app.js"></script>
  </body>
</html>